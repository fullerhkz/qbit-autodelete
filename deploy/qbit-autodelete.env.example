# qbit-autodelete — template de implantacao.
# Contem placeholders; preencha antes de usar.

# Conexao
QBT_URL="http://QBT_HOST:QBT_PORT"
QBT_USER="QBT_USERNAME"
QBT_PASS="QBT_PASSWORD"

# Regras
CATEGORY_RULES_FILE="/PATH/TO/qbit-autodelete.categories"
INCLUDE_NO_CATEGORY="false"
NO_CATEGORY_RETENTION_HOURS="168"
DEFAULT_MIN_RATIO="1.0"
RATIO_PROTECTION_MAX_HOURS="336"
EMERGENCY_RATIO_PROTECTION_MAX_HOURS="24"

DRY_RUN="false"
LOG_LEVEL="summary"
DELETE_FILES="true"
ALLOW_INCOMPLETE_DELETE="false"
PROTECTED_TAGS="keep,never-delete"
SKIP_FORCE_STARTED="true"
SKIP_ACTIVE_TRANSFERS="true"
MIN_INACTIVE_HOURS="6"

NORMAL_CLEANUP_ENABLED="true"
NORMAL_MIN_SCORE=60
AGGRESSIVE_MIN_SCORE=20
AGGRESSIVE_WITHOUT_HISTORY=false
MAX_DELETE_PER_RUN=30
MAX_RECLAIM_GB_PER_RUN=800

SCORE_LOW_UPLOAD_WEIGHT="45"
SCORE_SIZE_WEIGHT="20"
SCORE_INACTIVITY_WEIGHT="20"
SCORE_COMPETITION_WEIGHT="15"
UPLOAD_EFFICIENCY_FULL_MIB_PER_GIB_DAY="100"
SIZE_FULL_SCORE_GB="100"
INACTIVITY_FULL_SCORE_HOURS="168"

STATE_FILE=/var/lib/qbit-autodelete/state.json
LOCK_FILE=/var/lib/qbit-autodelete/run.lock
HISTORY_MIN_SAMPLES="6"
HISTORY_MIN_HOURS="6"
HISTORY_MIN_SAMPLE_SECONDS=1500
UPLOAD_EWMA_ALPHA_PERCENT="35"

DISK_PRESSURE_ENABLED=true
STORAGE_PATH=/
LOW_WATERMARK_GB="0"
HIGH_WATERMARK_GB="0"
LOW_WATERMARK_PERCENT=30
HIGH_WATERMARK_PERCENT=40
CRITICAL_WATERMARK_PERCENT=25

EMERGENCY_MIN_SCORE=0
EMERGENCY_WITHOUT_HISTORY=true
EMERGENCY_MAX_DELETE_PER_RUN=40
EMERGENCY_MAX_RECLAIM_GB_PER_RUN=1200

CURL_INSECURE="false"
CONNECT_TIMEOUT="10"
REQUEST_TIMEOUT="60"
LOGIN_RETRIES="5"
