[Unit]
Description=Verificador de pressao de disco do qbit-autodelete
Documentation=https://github.com/fullerhkz/qbit-autodelete
Wants=network-online.target
# Opcional: avise quando a rodada falhar, por exemplo OnFailure=qbit-autodelete-failure@%n.service
After=network-online.target

[Service]
Type=oneshot
User=QBIT_SERVICE_USER
Group=QBIT_SERVICE_GROUP
ExecStart=/PATH/TO/qbit-autodelete --pressure-gate --config /PATH/TO/qbit-autodelete.env
UMask=0077
Nice=10
# Um find travado no disco nao pode bloquear as proximas rodadas em silencio.
TimeoutStartSec=20min
# Prioridade baixa, mas nao ociosa: a classe idle morre de fome com o disco ocupado.
IOSchedulingClass=best-effort
IOSchedulingPriority=7
NoNewPrivileges=true
CapabilityBoundingSet=
PrivateDevices=true
PrivateTmp=true
ProtectClock=true
ProtectControlGroups=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
ProtectHome=read-only
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
StateDirectory=qbit-autodelete
StateDirectoryMode=0700

# O journal faz rotacao e evita um arquivo de log sem limite.
StandardOutput=journal
StandardError=journal
SyslogIdentifier=qbit-autodelete-gate
